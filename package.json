{
  "name": "flowdesk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @flowdesk/web --filter @flowdesk/api dev",
    "build": "pnpm --filter @flowdesk/contracts build && pnpm --filter @flowdesk/config build && pnpm --filter @flowdesk/api build && pnpm --filter @flowdesk/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @flowdesk/api test:integration",
    "test:e2e": "pnpm --filter @flowdesk/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
