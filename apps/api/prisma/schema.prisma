generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityActorType {
  USER
  AUTOMATION
}

enum ActivityEntityType {
  CLIENT
  PROJECT
  TASK
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @unique @db.VarChar(320)
  name                String                @db.VarChar(100)
  passwordHash        String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]
  invitationsSent     WorkspaceInvitation[] @relation("InvitationSender")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?   @db.VarChar(512)
  ipAddress  String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id          String                @id @default(uuid()) @db.Uuid
  name        String                @db.VarChar(100)
  slug        String                @unique @db.VarChar(140)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  memberships Membership[]
  invitations WorkspaceInvitation[]
  clients     Client[]
  projects    Project[]
  tasks       Task[]
  activities  Activity[]
}

model Membership {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @db.Uuid
  userId          String        @db.Uuid
  role            WorkspaceRole
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedClients Client[]      @relation("ClientAssignee")
  assignedTasks   Task[]        @relation("TaskAssignee")

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Client {
  id               String       @id @default(uuid()) @db.Uuid
  workspaceId      String       @db.Uuid
  name             String       @db.VarChar(120)
  company          String?      @db.VarChar(120)
  email            String?      @db.VarChar(320)
  phone            String?      @db.VarChar(40)
  notes            String?
  status           ClientStatus @default(ACTIVE)
  assignedMemberId String?      @db.Uuid
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedMember   Membership?  @relation("ClientAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  projects         Project[]

  @@index([workspaceId, status, archivedAt])
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  clientId    String?       @db.Uuid
  name        String        @db.VarChar(160)
  description String?
  status      ProjectStatus @default(PLANNED)
  priority    Priority      @default(MEDIUM)
  deadline    DateTime?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([workspaceId, status, archivedAt])
  @@index([workspaceId, clientId])
}

model Task {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  projectId   String?     @db.Uuid
  assigneeId  String?     @db.Uuid
  title       String      @db.VarChar(200)
  description String?
  status      TaskStatus  @default(BACKLOG)
  priority    Priority    @default(MEDIUM)
  dueDate     DateTime?
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee    Membership? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, archivedAt])
  @@index([workspaceId, projectId])
  @@index([workspaceId, assigneeId])
}

model Activity {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @db.Uuid
  actorId     String             @db.Uuid
  actorType   ActivityActorType
  entityType  ActivityEntityType
  entityId    String             @db.Uuid
  action      String             @db.VarChar(120)
  createdAt   DateTime           @default(now())
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityId, createdAt])
}

model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  email       String        @db.VarChar(320)
  role        WorkspaceRole
  tokenHash   String        @unique @db.Char(64)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String        @db.Uuid
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}
